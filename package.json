{
  "name": "certifica-power-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma en español para preparar certificaciones Microsoft Power Platform",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run typecheck && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "validate": "vite-node scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check-links": "vite-node scripts/check-links.ts",
    "check-outline": "vite-node scripts/check-outline.ts",
    "question-quality": "vite-node scripts/question-quality.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
